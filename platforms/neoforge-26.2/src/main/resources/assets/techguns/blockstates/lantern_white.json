{
  "multipart": [
    {
      "apply": {
        "model": "techguns:block/lantern_white"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "techguns:block/lantern_side_white",
        "y": 270
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "techguns:block/lantern_side_white"
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "techguns:block/lantern_side_white",
        "y": 90
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "techguns:block/lantern_side_white",
        "y": 180
      }
    },
    {
      "when": {
        "up": "true"
      },
      "apply": {
        "model": "techguns:block/lantern_top_white"
      }
    },
    {
      "when": {
        "down": "true"
      },
      "apply": {
        "model": "techguns:block/lantern_top_white",
        "x": 180
      }
    }
  ]
}
